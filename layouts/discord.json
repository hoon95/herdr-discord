{
  "id": "root",
  "type": "row",
  "theme": "graphite",
  "ui_font": "Pretendard",
  "background": "canvas",
  "terminal_padding": [
    10,
    16
  ],
  "titlebar": "none",
  "traffic_lights": [
    16,
    14
  ],
  "resizable": false,
  "preview": "layouts/discord.svg",
  "children": [
    {
      "id": "rail",
      "type": "block",
      "size": {
        "px": 72
      },
      "content": {
        "mod": "discord",
        "props": {
          "view": "rail"
        }
      },
      "window_drag": true
    },
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 240
      },
      "resizable": false,
      "children": [
        {
          "id": "channels",
          "type": "block",
          "content": {
            "mod": "discord",
            "props": {
              "view": "channels"
            }
          }
        },
        {
          "id": "user",
          "type": "block",
          "size": {
            "px": 52
          },
          "content": {
            "mod": "discord",
            "props": {
              "view": "user"
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "header",
          "type": "block",
          "size": {
            "px": 48
          },
          "content": {
            "mod": "discord",
            "props": {
              "view": "header"
            }
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "background": "background",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 2,
                  "radius": 0,
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "background"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  }
                }
              }
            },
            {
              "id": "members",
              "type": "block",
              "size": {
                "px": 240
              },
              "min": 200,
              "max": 360,
              "content": {
                "mod": "discord",
                "props": {
                  "view": "members"
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ]
        }
      ]
    }
  ],
  "colors": {
    "background": "#313338",
    "foreground": "#dbdee1",
